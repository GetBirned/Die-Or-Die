[sub_resource type="GDScript" id="GDScript_gkg68"]
script/source = "extends Node2D

@onready var numbers_container := $Hover/Numbers

# Called when the node enters the scene tree for the first time.
func _ready():
	GameInfo.connect(\"score_updated\", on_score_updated)
	GameInfo.connect(\"holder_updated\", on_holder_updated)

var numbers = []
var x = 0
var score = 0


func on_holder_updated(faces):
	if faces.size() == 0:
		$Hover/HandSprite.play(\"default\")
		return
		
	var hand = \"high number\"
	GameInfo.hand_multiplier = 1
	
	var counts = {}
	for face in faces:
		if counts.has(face):
			counts[face] = counts[face] + 1
		else:
			counts[face] = 1
	var pairs = 0
	var triples = 0
	var quads = 0
	var quint = 0
	
	for key in counts.keys():
		if counts[key] >= 2:
			pairs += 1
		if counts[key] >= 3:
			triples += 1
		if counts[key] >= 4:
			quads += 1
		if counts[key] >= 5:
			quint += 1
	
	if is_straight(faces):
		hand = \"straight\"
		GameInfo.hand_multiplier = 4	
	elif quint > 0:
		hand = \"five of a kind\"
		GameInfo.hand_multiplier = 10
	elif quads > 0:
		hand = \"four of a kind\"
		GameInfo.hand_multiplier = 6
	elif triples > 0:
		if pairs > 1:
			hand = \"full house\"
			GameInfo.hand_multiplier = 4
		else:
			hand = \"three of a kind\"
			GameInfo.hand_multiplier = 3
	elif pairs > 1:
		hand = \"two pair\"
		GameInfo.hand_multiplier = 2
	elif pairs > 0:
		hand = \"pair\"
		GameInfo.hand_multiplier = 2
	else:
		hand = \"high number\"
		GameInfo.hand_multiplier = 1
		
	GameInfo.hand = hand
	$Hover/HandSprite.play(hand)
	
func is_straight(values):
	if values.size() == 5:
		values.sort()
		
		var previous = values[0] - 1
		for value in values:
			if value != previous + 1:
				return false
			previous = value
		
		return true
	return false
		

func on_score_updated():
	
	var score_temp = int(GameInfo.current_score)
	
	for child in numbers_container.get_children():
		numbers_container.remove_child(child)
		child.queue_free()
		
	if score_temp < 1:
		numbers_container.hide()
		return
	else:
		numbers_container.show()
		
	var pitch_base = 1.0
	var pitch_scale = 0.05  # tune pitch here
	$BlipPlayer.stop()
	$BlipPlayer.pitch_scale = pitch_base + GameInfo.current_score * pitch_scale
	$BlipPlayer.play()
		
	var digits = 0
	while score_temp >= 1:
		score_temp = score_temp / 10
		digits += 1
	
	for i in range(digits):
		numbers_container.add_child(load(\"res://scenes/digit.tscn\").instantiate())
			
	var children = numbers_container.get_children()
	
	x = 0
	score = int(GameInfo.current_score)
	
	for digit in children:
		digit.set_value(score % 10)
		score = score / 10
		digit.position.x = x
		x -= digit.get_spacing()
		digit.modulate = Color(\"#000000\")
		digit.appear()
"

