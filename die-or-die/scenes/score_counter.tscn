[sub_resource type="GDScript" id="GDScript_gkg68"]
script/source = "extends Node2D


# Called when the node enters the scene tree for the first time.
func _ready():
	GameInfo.connect(\"score_updated\", on_score_updated)
	GameInfo.connect(\"holder_updated\", on_holder_updated)

var mutex = Mutex.new()
var numbers = []
var x = 0
var score = 0

var delay = 0

func _process(delta):
	mutex.lock()
	if not numbers.is_empty():
		if delay > 0:
			delay -= 1
		else:
			var number = numbers.pop_front()
			number.set_value(score % 10)
			score = score / 10
			number.position.x = x
			x -= number.get_spacing()
			number.modulate = Color(\"#000000\")
			number.appear()
			delay = 60 * delta
	mutex.unlock()

func on_holder_updated(faces):
	if faces.size() == 0:
		$Label.text = \"\"
		return
		
	var hand = \"high number\"
	var counts = {}
	for face in faces:
		if counts.has(face):
			counts[face] = counts[face] + 1
		else:
			counts[face] = 1
	var pairs = 0
	var triples = 0
	var quads = 0
	var quint = 0
	
	for key in counts.keys():
		if counts[key] >= 2:
			pairs += 1
		if counts[key] >= 3:
			triples += 1
		if counts[key] >= 4:
			quads += 1
		if counts[key] >= 5:
			quint += 1
			
	if quint > 0:
		hand = \"five of a kind\"
	elif quads > 0:
		hand = \"four of a kind\"
	elif triples > 0:
		if pairs > 1:
			hand = \"full house\"
		else:
			hand = \"three of a kind\"
	elif pairs > 1:
		hand = \"two pair\"
	elif pairs > 0:
		hand = \"pair\"
	else:
		hand = \"high number\"
	
	$Label.text = hand
		

func on_score_updated():
	mutex.lock()
	
	var score_temp = int(GameInfo.current_score)
	
	for child in $Numbers.get_children():
		$Numbers.remove_child(child)
		child.queue_free()
		
	if score_temp < 1:
		$Numbers.hide()
	else:
		$Numbers.show()
		
		var digits = 0
		while score_temp >= 1:
			score_temp = score_temp / 10
			digits += 1
		
		for i in range(digits):
			$Numbers.add_child(load(\"res://scenes/digit.tscn\").instantiate())
				
		var children = $Numbers.get_children()
		
		x = 0
		score = int(GameInfo.current_score)
		numbers = children
	
	mutex.unlock()
		#
		#for i in range(children.size()):
			#children[i].set_value(score % 10)
			#score = score / 10
			#children[i].position.x = x
			#x -= children[i].get_spacing()
			#children[i].modulate = Color(\"#000000\")
			#children[i].appear()
"

