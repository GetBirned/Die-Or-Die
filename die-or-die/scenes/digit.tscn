[sub_resource type="GDScript" id="GDScript_8rcid"]
script/source = "extends AnimatedSprite2D

func _ready():
	hide()
	
func _process(delta):
	if scale != Vector2(1,1):
		scale = scale.move_toward(Vector2(1,1), 4*delta)
	
func appear():
	scale = Vector2(1.3, 1.3)
	show()

func set_value(value):
	set_frame(value % 10)

func get_spacing():
	var gap = 4
	match frame:
		0:
			return 35 + gap
		1:
			return 25 + gap
		2:
			return 31 + gap
		3:
			return 33 + gap
		4:
			return 35 + gap
		5:
			return 33 + gap
		6:
			return 34 + gap
		7:
			return 35 + gap
		8:
			return 36 + gap
		9:
			return 34 + gap
	
"

